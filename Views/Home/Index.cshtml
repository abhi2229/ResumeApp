@model ResumeApp.Models.ResumeViewModel
@{
    ViewData["Title"] = "Resume";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var nameParts = (Model.Profile?.Name ?? "Abhishek Maiti").Split(' ');
    var firstName = nameParts[0];
    var lastName = nameParts.Length > 1 ? string.Join(" ", nameParts.Skip(1)) : "";
    var currentTemplate = string.IsNullOrEmpty(Model.SelectedTemplate) ? "amber-dark" : Model.SelectedTemplate;
}

<script>
  (function() {
    document.documentElement.setAttribute('data-template', '@currentTemplate');
  })();
</script>

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/templates.css" asp-append-version="true" />

<style media="print">
  @@page {
    size: A4 portrait;
    margin: 0.4in 0.4in;
  }
  @@media print {
    .exp-section { page-break-inside: avoid; }
    .exp-entry:nth-child(n+4) { page-break-before: avoid; }
    .projects-section { page-break-inside: avoid; }
    .proj-card:nth-child(n+3) { page-break-before: avoid; }
    .admin-bar, .admin-modal-overlay, .edit-controls, .btn-add-section { display: none !important; }
  }
</style>

<!-- ══ FLOATING ADMIN BAR ═══════════════════════════════════════════════════ -->
<div id="admin-bar" class="admin-bar" style="display: none;">
  <div class="admin-bar-info">
    <span class="admin-badge">⚡ Admin Mode Active</span>
    <div style="display:flex; align-items:center; gap:6px;">
      <label style="font-size:0.78rem; opacity:0.8;">Template:</label>
      <select id="admin-template-select" class="admin-form-input" style="padding:4px 8px; font-size:0.8rem; width:auto; background:rgba(255,255,255,0.1); border-color:rgba(255,255,255,0.2);" onchange="switchTemplateTheme(this.value)">
        <option value="amber-dark" selected="@(currentTemplate == "amber-dark")">1. Signature Amber (Dark)</option>
        <option value="executive-slate" selected="@(currentTemplate == "executive-slate")">2. Executive Slate (Corporate)</option>
        <option value="glassmorphism-neo" selected="@(currentTemplate == "glassmorphism-neo")">3. Glassmorphism Neo (Tech)</option>
        <option value="classic-editorial" selected="@(currentTemplate == "classic-editorial")">4. Classic Editorial (Minimal)</option>
      </select>
    </div>
  </div>
  <div class="admin-bar-actions">
    <button id="admin-save-btn" class="btn-admin btn-admin-primary" onclick="saveAllResumeData()">
      💾 Save All Changes
    </button>
    <button class="btn-admin btn-admin-secondary" onclick="document.body.classList.toggle('admin-editing')">
      👁 Toggle Outlines
    </button>
    <button class="btn-admin btn-admin-danger" onclick="handleAdminLogout()">
      🔒 Logout
    </button>
  </div>
</div>

<!-- ══ HIDDEN ADMIN LOGIN MODAL ═════════════════════════════════════════════ -->
<div id="admin-login-modal" class="admin-modal-overlay">
  <div class="admin-modal-card">
    <div class="admin-modal-header">
      <div class="admin-modal-title">🔐 Admin Login</div>
      <button class="admin-modal-close" onclick="closeLoginModal()">&times;</button>
    </div>
    <form onsubmit="handleAdminLogin(event)">
      <div id="admin-login-error" style="display:none; color:#f87171; background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.3); padding:8px 12px; border-radius:8px; font-size:0.85rem; margin-bottom:14px;"></div>
      <div class="admin-form-group">
        <label class="admin-form-label">Username</label>
        <input type="text" id="admin-username" class="admin-form-input" placeholder="Enter admin username" required />
      </div>
      <div class="admin-form-group">
        <label class="admin-form-label">Password</label>
        <input type="password" id="admin-password" class="admin-form-input" placeholder="Enter admin password" required />
      </div>
      <div class="admin-modal-footer">
        <button type="button" class="btn-admin btn-admin-secondary" onclick="closeLoginModal()">Cancel</button>
        <button type="submit" class="btn-admin btn-admin-primary">Login to Admin</button>
      </div>
    </form>
  </div>
</div>

<div class="shell">

  <!-- ══ SIDEBAR ═══════════════════════════ -->
  <aside class="sidebar">

    <div class="photo-block">
      <img src="image\Profile.jpeg" alt="@Model.Profile.Name" />
      <div class="photo-overlay"></div>
      <div class="photo-name">
        <h2>
          <span data-editable="true" data-profile="Name">@Model.Profile.Name</span>
        </h2>
        <div class="role-badge" data-editable="true" data-profile="Title">@Model.Profile.Title</div>
      </div>
    </div>

    <div class="sidebar-body">

      <!-- Contact -->
      <div class="s-section">
        <div class="s-label">Contact</div>
        <div class="contact-stack">
          <a class="c-link" href="@Model.Profile.LinkedIn" target="_blank">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            <span>LinkedIn Profile</span>
          </a>
          <a class="c-link" href="mailto:@Model.Profile.Email">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span data-editable="true" data-profile="Email">@Model.Profile.Email</span>
          </a>
          <a class="c-link" href="tel:@Model.Profile.Phone">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.59 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.56a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span data-editable="true" data-profile="Phone">@Model.Profile.Phone</span>
          </a>
          <span class="c-link">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span data-editable="true" data-profile="Location">@Model.Profile.Location</span>
          </span>
        </div>
      </div>

      <div class="s-divider"></div>

      <!-- Core Skills & Categories -->
      <div id="skills-container">
        @foreach (var sg in Model.SkillGroups)
        {
          <div class="s-section" data-skill-group="true" data-id="@sg.Id">
            <div class="s-label" data-editable="true" data-sg="Category">@sg.Category</div>
            <div class="s-skills">
              @foreach (var skill in sg.Skills)
              {
                <div class="skill-bar-item @(skill.IsPrimary ? "primary-skill" : "")" data-id="@skill.Id" data-percent="@skill.Percent">
                  <div class="skill-bar-top">
                    <span class="skill-bar-name" data-editable="true" data-skill="Name">@skill.Name</span>
                  </div>
                  <div class="skill-bar-track"><div class="skill-bar-fill" data-width="@skill.Percent"></div></div>
                  <div class="edit-controls">
                    <button class="btn-icon-action" onclick="moveItemUp(this)">▲</button>
                    <button class="btn-icon-action" onclick="moveItemDown(this)">▼</button>
                    <button class="btn-icon-action delete" onclick="deleteItem(this)">🗑</button>
                  </div>
                </div>
              }
            </div>
          </div>
          <div class="s-divider"></div>
        }
      </div>

      <!-- Education -->
      <div class="s-section">
        <div class="s-label">Education</div>
        <div id="education-container">
          @foreach (var edu in Model.Educations)
          {
            <div class="edu-item" data-id="@edu.Id" style="margin-bottom:0.8rem;">
              <div style="color:var(--text);font-size:0.7rem;margin-bottom:0.1rem;" data-editable="true" data-edu="Degree">@edu.Degree</div>
              <div style="color:var(--text-3);font-size:0.65rem;" data-editable="true" data-edu="Institution">@edu.Institution · <span data-edu="Year">@edu.Year</span></div>
              <div class="edit-controls">
                <button class="btn-icon-action" onclick="moveItemUp(this)">▲</button>
                <button class="btn-icon-action" onclick="moveItemDown(this)">▼</button>
                <button class="btn-icon-action delete" onclick="deleteItem(this)">🗑</button>
              </div>
            </div>
          }
        </div>
        <button class="btn-add-section" onclick="addNewEducation()">+ Add Education</button>
      </div>

      <div class="s-divider"></div>

      <!-- Certifications -->
      <div class="s-section">
        <div class="s-label">Certifications</div>
        <div id="certifications-container">
          @foreach (var cert in Model.Certifications)
          {
            <div class="cert-item" data-id="@cert.Id" data-url="@cert.CertificateUrl" style="margin-bottom:0.8rem;">
              <div style="color:var(--text);font-size:0.75rem;" data-editable="true" data-cert="Name">@cert.Name</div>
              <div style="color:var(--text-3);font-size:0.65rem;" data-editable="true" data-cert="Issuer">@cert.Issuer · <span data-cert="Year">@cert.Year</span></div>
              <div class="edit-controls">
                <button class="btn-icon-action" onclick="moveItemUp(this)">▲</button>
                <button class="btn-icon-action" onclick="moveItemDown(this)">▼</button>
                <button class="btn-icon-action delete" onclick="deleteItem(this)">🗑</button>
              </div>
            </div>
          }
        </div>
        <button class="btn-add-section" onclick="addNewCertification()">+ Add Certification</button>
      </div>

      <div class="s-divider"></div>

      <!-- LAST UPDATED TIMESTAMP & HIDDEN TRIGGER -->
      <div class="s-section" style="padding-top:4px;">
        <div class="last-updated-badge">
          <span>🕒 Last Updated:</span>
          <strong id="last-updated-time">@(string.IsNullOrEmpty(Model.LastUpdated) ? DateTime.UtcNow.ToString("dd MMM yyyy, hh:mm tt 'UTC'") : Model.LastUpdated)</strong>
        </div>
        <div style="text-align:right; margin-top:8px;">
          <span class="hidden-admin-trigger" title="Admin Portal Access" style="opacity:0.25; font-size:0.7rem;">•••</span>
        </div>
      </div>

    </div>
  </aside>

  <!-- ══ MAIN CONTENT ═══════════════════════ -->
  <main class="main-content" id="main">

    <!-- BIO HEADLINE -->
    <div class="headline-block fade-up">
      <div class="headline-kicker">About</div>
      <blockquote data-editable="true" data-profile="Bio">
       @Model.Profile.Bio
      </blockquote>
    </div>

    <!-- EXPERIENCE -->
    <section class="exp-section fade-up" id="experience">
      <div class="sec-head">
        <span class="sec-title">Work Experience</span>
        <div class="sec-line"></div>
      </div>

      <div id="experiences-container">
        @foreach (var exp in Model.Experiences)
        {
          <div class="exp-entry" data-id="@exp.Id">
            <div class="exp-header">
              <div>
                <div class="exp-co" data-editable="true" data-exp="Company">@exp.Company</div>
                <div class="exp-role-title" data-editable="true" data-exp="Role">@exp.Role</div>
              </div>
              <div class="exp-period-badge" data-editable="true" data-exp="Period">@exp.Period</div>
            </div>
            <div class="exp-type-pill" data-editable="true" data-exp="EmploymentType">@exp.EmploymentType</div>
            <ul class="exp-bullets">
              @foreach (var b in exp.Bullets)
              {
                <li class="exp-bullet-item">
                  <span data-editable="true">@b</span>
                  <div class="edit-controls">
                    <button class="btn-icon-action delete" onclick="deleteItem(this)">🗑 Delete Bullet</button>
                  </div>
                </li>
              }
            </ul>
            <button class="btn-icon-action btn-add-section" onclick="addBulletToExp(this)">+ Add Bullet</button>
            <div class="edit-controls">
              <button class="btn-icon-action" onclick="moveItemUp(this)">▲ Move Up</button>
              <button class="btn-icon-action" onclick="moveItemDown(this)">▼ Move Down</button>
              <button class="btn-icon-action delete" onclick="deleteItem(this)">🗑 Delete Experience</button>
            </div>
          </div>
        }
      </div>

      <button class="btn-add-section" onclick="addNewExperience()">+ Add New Work Experience</button>
    </section>

    <!-- PROJECTS (PROPER GRID LAYOUT) -->
    <section class="projects-section fade-up" id="projects" style="margin-top:2.5rem;">
      <div class="sec-head">
        <span class="sec-title">Key Projects</span>
        <div class="sec-line"></div>
      </div>

      <div id="projects-container" class="projects-list">
        @{ int projIndexCounter = 0; }
        @foreach (var proj in Model.Projects)
        {
          projIndexCounter++;
          <div class="proj-card" data-id="@proj.Id">
            <div class="proj-index">
              <span>@(projIndexCounter.ToString("D2"))</span>
            </div>
            <div class="proj-body">
              <div class="proj-title" data-editable="true" data-proj="Title">@proj.Title</div>
              <div class="proj-desc" data-editable="true" data-proj="Description">@proj.Description</div>
              <div class="proj-tags">
                @foreach (var tech in proj.Technologies)
                {
                  <span class="proj-tag" data-editable="true">@tech</span>
                }
                <button class="btn-icon-action edit-controls" onclick="addTechToProj(this)" style="display:none;">+ Tech</button>
              </div>
              <div class="edit-controls">
                <button class="btn-icon-action" onclick="moveItemUp(this)">▲ Move Up</button>
                <button class="btn-icon-action" onclick="moveItemDown(this)">▼ Move Down</button>
                <button class="btn-icon-action delete" onclick="deleteItem(this)">🗑 Delete Project</button>
              </div>
            </div>
          </div>
        }
      </div>

      <button class="btn-add-section" onclick="addNewProject()">+ Add New Project</button>
    </section>

    <!-- FOOTER -->
    <footer class="main-footer">
      <p>@Model.Profile.Name · Hyderabad (Current) · Digha, West Bengal (Permanent)</p>
      <p><a href="@Model.Profile.LinkedIn" target="_blank">LinkedIn</a> &nbsp;&middot;&nbsp; <a href="#" onclick="window.print();return false;">Print / PDF</a></p>
    </footer>

  </main>
</div>

<script src="~/js/admin.js" asp-append-version="true"></script>
